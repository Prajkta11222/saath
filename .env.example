# GEMINI_API_KEY: Optional for Gemini AI triage. Falls back to keyword rules when unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional Gemini model name (defaults to gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPERATOR_PASSWORD: Password for Operator Console access (set in Secrets; if unset, first-run operator setup is shown)
OPERATOR_PASSWORD=

# DEFAULT_LAT / DEFAULT_LNG: Default city map center (Nagpur, India)
DEFAULT_LAT="21.1458"
DEFAULT_LNG="79.0882"

# SQLITE_PATH: Optional path to SQLite database file
SQLITE_PATH="./saath.db"
